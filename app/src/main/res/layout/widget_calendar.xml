<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:orientation="vertical"
    android:padding="10dp"
    android:id="@+id/widget_root">

    <TextView
        android:id="@+id/widget_calendar_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today"
        android:textColor="#888888"
        android:textSize="11sp" />

    <TextView android:id="@+id/cal_r1_p" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F0F0F0" android:textSize="12sp" android:clickable="true" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/cal_r2_p" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#DDDDDD" android:textSize="12sp" android:clickable="true" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/cal_r3_p" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#CCCCCC" android:textSize="12sp" android:clickable="true" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/cal_r4_p" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BBBBBB" android:textSize="12sp" android:clickable="true" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/cal_r5_p" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#AAAAAA" android:textSize="12sp" android:clickable="true" android:maxLines="1" android:ellipsize="end" />

    <LinearLayout
        android:id="@+id/widget_calendar_weather_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_calendar_weather_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_calendar_weather_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#888888"
            android:textSize="10sp"
            android:layout_marginStart="4dp" />
    </LinearLayout>
</LinearLayout>
